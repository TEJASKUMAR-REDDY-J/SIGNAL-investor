# Copy to .env and fill in. .env is git-ignored; this example is committed.
# WARNING: values here are compiled into the APK and can be extracted from it.
# Keep the APK private. If it leaks, revoke the key at https://console.groq.com/keys
#
# Build/run with:  flutter run --dart-define-from-file=.env
#                  flutter build apk --release --obfuscate --split-debug-info=build/symbols --dart-define-from-file=.env

# Groq API key (starts with gsk_). Paste after the = sign, no quotes, no spaces.
GROQ_API_KEY=

# Default assistant model; editable later in app Settings.
GROQ_MODEL=openai/gpt-oss-120b
